+	// verify C7 mutation: track every client transport dialed to the server
+	// listener so the test can force a reconnection to the same listener.
+	var (
+		c7mu    sync.Mutex
+		c7conns []net.Conn
+	)
+	c7dialer := func(dctx context.Context, addr string) (net.Conn, error) {
+		c, err := (&net.Dialer{}).DialContext(dctx, "tcp", addr)
+		if err == nil && addr == lis.Addr().String() {
+			c7mu.Lock()
+			c7conns = append(c7conns, c)
+			t.Logf("C7: client transport #%d dialed: local=%s remote=%s", len(c7conns), c.LocalAddr(), c.RemoteAddr())
+			c7mu.Unlock()
+		}
+		return c, err
+	}
+	c7forceReconnect := func() {
+		c7mu.Lock()
+		n := len(c7conns)
+		old := c7conns[n-1]
+		c7mu.Unlock()
+		t.Logf("C7: forcibly closing client transport #%d (local=%s)", n, old.LocalAddr())
+		old.Close()
+		for ; ctx.Err() == nil; <-time.After(defaultTestShortTimeout) {
+			c7mu.Lock()
+			m := len(c7conns)
+			c7mu.Unlock()
+			if m > n {
+				break
+			}
+		}
+		time.Sleep(200 * time.Millisecond) // let the new transport become READY
+	}
+	cc, err := grpc.NewClient(fmt.Sprintf("xds:///%s", serviceName), grpc.WithTransportCredentials(insecure.NewCredentials()), grpc.WithResolvers(xdsResolver), grpc.WithContextDialer(c7dialer))
 	if err != nil {
 		t.Fatalf("grpc.NewClient() failed: %v", err)
 	}
