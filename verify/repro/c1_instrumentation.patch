index 00000000..bc2bde85
--- /dev/null
+++ b/internal/xds/server/verify_instrumentation.go
@@ -0,0 +1,93 @@
+// AUDIT INSTRUMENTATION (verify run v-0faf5638) - not part of the solution.
+//
+// VERIFY_MODE selects a controlled release order; every mode emits an
+// independent lifecycle trace ("XTRACE ...") on stderr.
+//
+//	(unset)         solution's own ordering, trace only
+//	control         replacement: all retired interceptors, then old filters
+//	repl-mid        replacement: first retired interceptor, then old filters,
+//	                then the remaining retired interceptors
+//	shutdown-early  replacement as control; shutdown: filters released
+//	                before the interceptors of the active configuration
+
+package server
+
+import (
+	"fmt"
+	"os"
+
+	"google.golang.org/grpc/internal/resolver"
+	"google.golang.org/grpc/internal/xds/httpfilter"
+)
+
+var verifyMode = os.Getenv("VERIFY_MODE")
+
+func vtrace(format string, a ...any) {
+	fmt.Fprintf(os.Stderr, "XTRACE "+format+"\n", a...)
+}
+
+func (rc *usableRouteConfiguration) verifyInterceptors() []resolver.ServerInterceptor {
+	if rc == nil {
+		return nil
+	}
+	var is []resolver.ServerInterceptor
+	for _, vh := range rc.vhs {
+		for _, r := range vh.routes {
+			if r.interceptor != nil {
+				is = append(is, r.interceptor)
+			}
+		}
+	}
+	return is
+}
+
+func verifyRelease(sfs []httpfilter.ServerFilter) {
+	for _, sf := range sfs {
+		sf.Close()
+	}
+}
+
+func (fc *filterChain) verifyReplace(urc *usableRouteConfiguration) {
+	old := fc.usableRouteConfiguration.Swap(urc)
+	is := old.verifyInterceptors()
+	retired := fc.verifyRetiredFilters
+	fc.verifyRetiredFilters = nil
+	vtrace("replacement begin mode=%q retired-interceptors=%d retired-filter-refs=%d", verifyMode, len(is), len(retired))
+	switch verifyMode {
+	case "repl-mid":
+		for n, i := range is {
+			i.Close()
+			if n == 0 {
+				verifyRelease(retired)
+			}
+		}
+		if len(is) == 0 {
+			verifyRelease(retired)
+		}
+	default: // control, shutdown-early
+		for _, i := range is {
+			i.Close()
+		}
+		verifyRelease(retired)
+	}
+	vtrace("replacement end")
+}
+
+func (fcm *filterChainManager) verifyStop() {
+	for _, fc := range fcm.filterChains {
+		is := fc.usableRouteConfiguration.Load().verifyInterceptors()
+		vtrace("shutdown begin mode=%q active-interceptors=%d filter-refs=%d", verifyMode, len(is), len(fc.serverFilters))
+		if verifyMode == "shutdown-early" {
+			fc.stop()
+			for _, i := range is {
+				i.Close()
+			}
+		} else {
+			for _, i := range is {
+				i.Close()
+			}
+			fc.stop()
+		}
+		vtrace("shutdown end")
+	}
+}
