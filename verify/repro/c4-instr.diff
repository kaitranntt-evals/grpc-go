 	return es.childLB.UpdateClientConnState(state)
 }
 
@@ -394,7 +398,9 @@ func (es *endpointState) close() {
 func (es *endpointState) exitIdle() {
 	es.childMu.Lock()
 	if !es.closed {
+		auditStall("ES_EXITIDLE_STALL_BEFORE")
 		es.childLB.ExitIdle()
+		auditStall("ES_EXITIDLE_STALL_AFTER")
 	}
 	es.childMu.Unlock()
 }
