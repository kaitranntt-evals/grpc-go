# calls the initial lb.UpdateClientConnState synchronously with no local
# deadline, so the test never regains control.
#   cd <checkout of grpc-go-endpointsharding-decouple-locking-perfect> && git apply verify/repro/c5_stall_initial_config.patch && \
#   go test ./balancer/endpointsharding -run 'Test/SameChildMutualExclusion$' -race -count=1 -timeout 20s -v ; git checkout -- balancer/endpointsharding/endpointsharding_test.go
# Expected: no test-level failure message; only the go test -timeout panic, with
# the test goroutine parked in lb.UpdateClientConnState at the initial call.
--- a/balancer/endpointsharding/endpointsharding_test.go
+++ b/balancer/endpointsharding/endpointsharding_test.go
@@ -356,7 +356,7 @@ func (s) TestSameChildMutualExclusion(t *testing.T) {
 			enterUpdate:  updateEntered,
 			releaseBlock: updateHold,
